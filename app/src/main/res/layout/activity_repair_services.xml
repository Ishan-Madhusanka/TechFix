<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvServicesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repair Services"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp" />

    <Button
        android:id="@+id/btnScreenRepair"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Screen Repair"
        app:layout_constraintTop_toBottomOf="@id/tvServicesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/btnBatteryRepair"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Battery Replacement"
        app:layout_constraintTop_toBottomOf="@id/btnScreenRepair"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnChargingRepair"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Charging Port Repair"
        app:layout_constraintTop_toBottomOf="@id/btnBatteryRepair"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnSoftwareRepair"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Software Repair"
        app:layout_constraintTop_toBottomOf="@id/btnChargingRepair"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>