<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D18"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="35dp">

        <!-- TechFix Logo -->
        <TextView
            android:id="@+id/tvBookLogo"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/bg_icon_circle"
            android:gravity="center"
            android:text="TF"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvBookRepairTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="Book Repair"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBookLogo" />

        <!-- Small Blue Line -->
        <View
            android:id="@+id/bookRepairLine"
            android:layout_width="45dp"
            android:layout_height="4dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_small_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBookRepairTitle" />

        <!-- Selected Service Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectedServiceCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="#111827"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bookRepairLine"
            app:strokeColor="#3B82F6"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvSelectedService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:text="Selected Service: Screen Repair"
                android:textColor="#60A5FA"
                android:textSize="14sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Device Brand -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDeviceBrand"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="10dp"
            android:hint="Device Brand"
            app:boxBackgroundColor="#111827"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#3B82F6"
            app:hintTextColor="#94A3B8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/selectedServiceCard">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDeviceBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Device Model -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDeviceModel"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="10dp"
            android:hint="Device Model"
            app:boxBackgroundColor="#111827"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#3B82F6"
            app:hintTextColor="#94A3B8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutDeviceBrand">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDeviceModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Problem Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDescription"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="10dp"
            android:hint="Describe the problem"
            app:boxBackgroundColor="#111827"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#3B82F6"
            app:hintTextColor="#94A3B8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutDeviceModel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:paddingTop="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Appointment Date -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAppointmentDate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="10dp"
            android:hint="Appointment Date"
            app:boxBackgroundColor="#111827"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#3B82F6"
            app:hintTextColor="#94A3B8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutDescription">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAppointmentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Damage Image -->
        <ImageView
            android:id="@+id/ivDamageImage"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="10dp"
            android:background="#111827"
            android:contentDescription="Selected damage image"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAppointmentDate" />

        <!-- Upload Image -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadImage"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="10dp"
            android:text="Upload Damage Image"
            android:textAllCaps="false"
            android:textColor="#60A5FA"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#111827"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivDamageImage"
            app:strokeColor="#3B82F6"
            app:strokeWidth="1dp" />

        <!-- Submit Booking -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitBooking"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="28dp"
            android:text="Submit Booking"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#3B82F6"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnUploadImage" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
