<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#111827"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Technician Name -->
        <TextView
            android:id="@+id/tvTechnicianName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ishan Madhusanka"
            android:textColor="#60A5FA"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Speciality -->
        <TextView
            android:id="@+id/tvTechnicianSpeciality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Speciality: Laptop Repair"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />

        <!-- Branch -->
        <TextView
            android:id="@+id/tvTechnicianBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Branch: colombo"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />

        <!-- Phone -->
        <TextView
            android:id="@+id/tvTechnicianPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Phone: 0771234567"
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <!-- Availability -->
        <TextView
            android:id="@+id/tvTechnicianAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_icon_circle"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Available"
            android:textColor="#22C55E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvTechnicianStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_icon_circle"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Active"
            android:textColor="#60A5FA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#334155" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- Edit -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditTechnician"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="#60A5FA"
                android:textStyle="bold"
                app:backgroundTint="#111827"
                app:cornerRadius="10dp"
                app:strokeColor="#3B82F6"
                app:strokeWidth="1dp" />

            <!-- Activate / Deactivate -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTechnician"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Deactivate"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#3B82F6"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>