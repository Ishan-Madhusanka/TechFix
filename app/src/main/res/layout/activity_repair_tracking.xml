<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8FF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#246BC4"
        android:paddingStart="18dp"
        android:paddingTop="26dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TechFix"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Repair Tracking"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Track the progress of your repair"
            android:textColor="#DCEAFF"
            android:textSize="11sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/txtTrackingRepairId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repair #TF001"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Repair Progress"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <!-- Tracking Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#D6E4F5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Pending -->
                    <TextView
                        android:id="@+id/statusPending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="✓  Pending"
                        android:textColor="#246BC4"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#D6E4F5" />

                    <!-- Confirmed -->
                    <TextView
                        android:id="@+id/statusConfirmed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="○  Confirmed"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#D6E4F5" />

                    <!-- Device Received -->
                    <TextView
                        android:id="@+id/statusDeviceReceived"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="○  Device Received"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#D6E4F5" />

                    <!-- Diagnosing -->
                    <TextView
                        android:id="@+id/statusDiagnosing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="○  Diagnosing"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#D6E4F5" />

                    <!-- Repairing -->
                    <TextView
                        android:id="@+id/statusRepairing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="○  Repairing"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#D6E4F5" />

                    <!-- Quality Check -->
                    <TextView
                        android:id="@+id/statusQualityCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="○  Quality Check"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#D6E4F5" />

                    <!-- Ready For Collection -->
                    <TextView
                        android:id="@+id/statusReadyCollection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="○  Ready For Collection"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#D6E4F5" />

                    <!-- Completed -->
                    <TextView
                        android:id="@+id/statusCompleted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="○  Completed"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Current Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#E3F0FF"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#B9D5F5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Status"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtCurrentStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="PENDING"
                        android:textColor="#246BC4"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>