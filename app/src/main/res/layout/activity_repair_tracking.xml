<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080D18">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111827"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TechFix"
            android:textColor="#60A5FA"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Repair Tracking"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Track the progress of your repair"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Repair ID -->
            <TextView
                android:id="@+id/txtTrackingRepairId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repair #TF001"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Repair Progress"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <!-- Tracking Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Pending -->
                    <TextView
                        android:id="@+id/statusPending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Γ£ô  Pending"
                        android:textColor="#60A5FA"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#334155" />

                    <!-- Confirmed -->
                    <TextView
                        android:id="@+id/statusConfirmed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Γùï  Confirmed"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#334155" />

                    <!-- Device Received -->
                    <TextView
                        android:id="@+id/statusDeviceReceived"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Γùï  Device Received"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#334155" />

                    <!-- Diagnosing -->
                    <TextView
                        android:id="@+id/statusDiagnosing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Γùï  Diagnosing"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#334155" />

                    <!-- Repairing -->
                    <TextView
                        android:id="@+id/statusRepairing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Γùï  Repairing"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#334155" />

                    <!-- Quality Check -->
                    <TextView
                        android:id="@+id/statusQualityCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Γùï  Quality Check"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#334155" />

                    <!-- Ready For Collection -->
                    <TextView
                        android:id="@+id/statusReadyCollection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Γùï  Ready For Collection"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="18dp"
                        android:background="#334155" />

                    <!-- Completed -->
                    <TextView
                        android:id="@+id/statusCompleted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Γùï  Completed"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Current Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#3B82F6"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Status"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtCurrentStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="PENDING"
                        android:textColor="#60A5FA"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
