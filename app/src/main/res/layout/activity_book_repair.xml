<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F4F8"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="35dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvBookRepairTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Repair"
            android:textColor="#263238"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/viewDivider"
            android:layout_width="65dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:background="#1565C0"
            app:layout_constraintTop_toBottomOf="@id/tvBookRepairTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Selected Service -->
        <TextView
            android:id="@+id/tvSelectedService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Selected Service"
            android:textColor="#1565C0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/viewDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Device Brand -->
        <TextView
            android:id="@+id/tvDeviceBrandLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Device Brand"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvSelectedService"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etDeviceBrand"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#90A4AE"
            android:hint="Enter device brand"
            android:inputType="text"
            android:textColor="#263238"
            android:textColorHint="#78909C"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceBrandLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Device Model -->
        <TextView
            android:id="@+id/tvDeviceModelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Device Model"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etDeviceBrand"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etDeviceModel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#90A4AE"
            android:hint="Enter device model"
            android:inputType="text"
            android:textColor="#263238"
            android:textColorHint="#78909C"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceModelLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Laptop / Desktop Operating System -->
        <TextView
            android:id="@+id/tvOperatingSystemLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Operating System"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/etDeviceModel"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etOperatingSystem"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#90A4AE"
            android:hint="Enter operating system"
            android:inputType="text"
            android:textColor="#263238"
            android:textColorHint="#78909C"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvOperatingSystemLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Desktop RAM -->
        <TextView
            android:id="@+id/tvRamLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RAM"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/etOperatingSystem"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etRam"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#90A4AE"
            android:hint="Example: 8GB"
            android:inputType="text"
            android:textColor="#263238"
            android:textColorHint="#78909C"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvRamLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Gaming Console Controller Problem -->
        <TextView
            android:id="@+id/tvControllerProblemLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Controller Problem"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/etRam"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etControllerProblem"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#90A4AE"
            android:gravity="top|start"
            android:hint="Describe controller problem if any"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingTop="8dp"
            android:textColor="#263238"
            android:textColorHint="#78909C"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvControllerProblemLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Problem Description -->
        <TextView
            android:id="@+id/tvProblemLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Problem Description"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etControllerProblem"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#90A4AE"
            android:gravity="top|start"
            android:hint="Describe the problem here..."
            android:inputType="textMultiLine|textCapSentences"
            android:paddingTop="8dp"
            android:textColor="#263238"
            android:textColorHint="#78909C"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvProblemLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Appointment Date - ALL DEVICES -->
        <TextView
            android:id="@+id/tvAppointmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Appointment Date"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etDescription"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etAppointmentDate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#90A4AE"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select appointment date"
            android:inputType="none"
            android:textColor="#263238"
            android:textColorHint="#78909C"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvAppointmentLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Damage Image Preview - ALL DEVICES -->
        <ImageView
            android:id="@+id/ivDamageImage"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Selected damage image"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/etAppointmentDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Upload Damage Image - ALL DEVICES -->
        <Button
            android:id="@+id/btnUploadImage"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#607D8B"
            android:text="Upload Damage Image"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/ivDamageImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Take Photo - ALL DEVICES -->
        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#607D8B"
            android:text="Take Photo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/btnUploadImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Submit Booking - ALL DEVICES -->
        <Button
            android:id="@+id/btnSubmitBooking"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#1565C0"
            android:text="Submit Booking"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnTakePhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>